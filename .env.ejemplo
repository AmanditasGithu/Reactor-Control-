# Copiá este archivo como ".env" (en la misma carpeta) y llená los valores.
# El .env NO se sube a GitHub (está en .gitignore): ahí van los secretos.
# Ver backend/README.md → "Login con Google y GitHub" para saber de dónde salen.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Dirección del backend. Si se cambia, hay que cambiarla también en Google y GitHub.
URL_BACKEND=http://localhost:8000

# Clave del control físico (Arduino) para el servidor de partidas.
# Inventá una palabra larga; el control debe enviarla en el encabezado x-control-token.
CONTROL_HARDWARE_TOKEN=

# Clave que comparten el servidor de partidas y el backend para enviar resultados (US-023).
# Inventá una palabra larga y usá la misma en los dos.
REACTOR_RESULTADOS_TOKEN=
