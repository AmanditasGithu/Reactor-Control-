# Copiá este archivo como ".env" (en la misma carpeta) y llená los valores.
# El .env NO se sube a GitHub (está en .gitignore): ahí van los secretos.
# Ver backend/README.md → "Login con Google y GitHub" para saber de dónde salen.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Dirección del backend. Si se cambia, hay que cambiarla también en Google y GitHub.
URL_BACKEND=http://localhost:8000
